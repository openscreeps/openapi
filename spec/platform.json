    "/room-history": {
      "get": {
        "operationId": "platformRoomHistory",
        "summary": "Read standalone room-history chunk",
        "description": "OpenScreeps returns timestamp, room, base and contiguous tick-keyed object diffs, without the usual ok wrapper. An object id maps to a new object, partial update, or null deletion. time must identify a retained frame; at most historyChunkSize frames are returned. Unlike the official static-history path, this route uses query parameters.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [
          {
            "name": "room",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RoomName"
            },
            "description": "Room name."
          },
          {
            "name": "time",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Base game tick, normally aligned to the advertised historyChunkSize."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PlatformHistory"
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "Requested history frame was not retained.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "unsupported",
          "openscreeps": "supported"
        },
        "x-sources": [
          "https://github.com/openscreeps/server/blob/3954fd26f107a4b508ccaf6b5f64e4aa951d9e91/src/http.ts#L39-L47",
          "https://github.com/openscreeps/server/blob/3954fd26f107a4b508ccaf6b5f64e4aa951d9e91/src/services/host.service.ts#L34-L46",
          "https://github.com/openscreeps/server/blob/3954fd26f107a4b508ccaf6b5f64e4aa951d9e91/src/realtime/diff.ts#L1-L35"
        ]
      }
    },
    "/room-history/{shard}/{room}/{tick}.json": {
      "get": {
        "operationId": "platformOfficialRoomHistory",
        "summary": "Read official room-history chunk",
        "description": "Official static history route. The reference client rounds tick down to a 100-tick chunk boundary; inspect /api/version for the current historyChunkSize. History consists of an initial object state followed by tick-keyed diffs, not complete independent room snapshots. Missing/expired chunks return 404, potentially non-JSON from the static host.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [
          {
            "name": "shard",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ShardName"
            },
            "description": "Shard name."
          },
          {
            "name": "room",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RoomName"
            },
            "description": "Room name."
          },
          {
            "name": "tick",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "First tick in the history chunk."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PlatformHistory"
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "History chunk not found; a static hosting error body is not guaranteed to be JSON."
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported",
          "openscreeps": "unsupported"
        },
        "x-sources": [
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/ScreepsHttpClient.ts#L370-L398",
