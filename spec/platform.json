              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PlatformVersion"
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported",
          "openscreeps": "supported"
        },
        "x-observations": [
          {
            "url": "https://screeps.com/api/version",
            "date": "2026-10-10",
            "notes": "Live official features use optional menuData, not the reference client's required menuItems. Official historyChunkSize is 100."
          }
