{
  "paths": {
    "/api/version": {
      "get": {
        "operationId": "platformVersion",
        "summary": "Read server capabilities",
        "description": "Reports protocol and server capabilities. The official web client fetches it without credentials to configure itself (history chunk size, renderer resources, feature menu). Official responses carry `features` with optional `menuData` and `shards`; the client falls back to the market and auth features when `serverData.features` is absent.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/PlatformVersion"
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported"
        },
        "x-observations": [
          {
            "url": "https://screeps.com/api/version",
            "date": "2026-10-10",
            "notes": "Live official features use optional menuData, not the reference client's required menuItems. Official historyChunkSize is 100."
          }
        ],
        "x-sources": [
          "https://screeps.com/a/app2/main.js?bust=1787842760865#L220605C46",
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/http/base.ts#L103-L151"
        ]
      }
    },
    "/api/servers/list": {
      "post": {
        "operationId": "platformServersList",
        "summary": "List community servers",
        "description": "Official curated list of community-run servers, fetched directly with `fetch` (not the Api wrapper). The client posts an optional Steam auth session `steamTicket` so the response can include the caller's `likes`; no player token is sent.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "integer",
                          "const": 1
                        },
                        "servers": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PlatformServer"
                          }
                        },
                        "likes": {
                          "type": "array",
                          "description": "Servers the Steam user liked; the client indexes entries by `server`.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "server": {
                                "type": "string"
                              }
                            },
                            "required": ["server"],
                            "additionalProperties": true
                          }
                        }
                      },
                      "required": ["ok", "servers"],
                      "additionalProperties": true
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported"
        },
        "x-sources": [
          "https://screeps.com/a/app2/main.js?bust=1787842760865#L204489C46",
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/ScreepsHttpClient.ts#L402-L414",
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/http/servers.ts#L1-L27"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "steamTicket": {
                    "type": "string",
                    "description": "Steam auth session ticket when the desktop client has one; omitted otherwise."
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "x-unverified": "`likes` entry fields other than `server` and the behavior without `steamTicket` are not evidenced."
      }
    },
    "/api/steam/news": {
      "get": {
        "operationId": "platformSteamNews",
        "summary": "Read Screeps Steam announcement feed",
        "description": "Screeps announcement feed in Valve ISteamNews `appnews` form. The official client polls it and reads only the first `appnews.newsitems` entry's `gid` and `title`, treating a missing feed as no news.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "integer",
                          "const": 1
                        },
                        "appnews": {
                          "type": "object",
                          "properties": {
                            "appid": {
                              "type": "integer"
                            },
                            "newsitems": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/PlatformNewsItem"
                              }
                            },
                            "count": {
                              "type": "integer"
                            }
                          },
                          "required": ["newsitems"],
                          "additionalProperties": true
                        }
                      },
                      "required": ["ok", "appnews"],
                      "additionalProperties": true
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported"
        },
        "x-sources": ["https://screeps.com/a/app2/main.js?bust=1787842760865#L216405C46"],
        "x-unverified": "Only `appnews.newsitems[0].gid`/`title` are read by the official client; remaining item fields follow the Valve news format and are not verified against screeps.com."
      }
    },
    "/api/xsolla/active-promotion": {
      "get": {
        "operationId": "platformActivePromotion",
        "summary": "Read item-shop promotion",
        "description": "Item-shop promotion banner data for the signed-in player. The official client requests it only when signed in and ignores failures. During a sale the response may carry `discount` and `dateUntil`.",
        "tags": ["Platform"],
        "security": [
          {},
          {
            "Token": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "integer",
                          "const": 1
                        },
                        "discount": {
                          "description": "Official promotion amount; upstream field type not established by pinned source."
                        },
                        "dateUntil": {
                          "description": "Official promotion end; upstream representation not established by pinned source."
                        }
                      },
                      "required": ["ok"],
                      "additionalProperties": true
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "supported"
        },
        "x-sources": ["https://screeps.com/a/build.min.js?bust=1787842760865#L1C287497"],
        "x-unverified": "The official client passes the result to the top bar without reading fields at the call site; `discount`/`dateUntil` value types are not established."
      }
    },
    "/api/experimental/pvp": {
      "get": {
        "operationId": "platformExperimentalPvp",
        "summary": "Find recently active combat rooms",
        "description": "Experimental official endpoint, including attacks against NPCs. The client defaults interval to 100; its documentation does not establish precise interval units or filtering direction.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            },
            "description": "Experimental filter; reference client default is 100; precise upstream units are undocumented."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result or logical API failure. Inspect error even on HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "integer",
                          "const": 1
                        },
                        "pvp": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/components/schemas/PlatformPvpShard"
                          }
                        }
                      },
                      "required": ["ok", "pvp"],
                      "additionalProperties": true
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ]
                }
              }
            }
          },
          "400": {
