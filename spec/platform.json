    "/assets/{path}": {
      "get": {
        "operationId": "platformAsset",
        "summary": "Read standalone client or terrain asset",
        "description": "OpenScreeps wildcard asset route. map/W1N1.png renders room terrain at 150×150; map/zoom2/W0N0.png renders an aligned 4×4-room sector at 200×200. Other files come from the optional operator asset directory, with traversal and symlink containment checks. The path can contain slashes; some generated clients encode them, so preserve the wildcard path when using this endpoint. This specification does not claim that official assets use the same URL scheme.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "examples": ["map/W1N1.png"]
            },
            "description": "Relative wildcard asset path, potentially containing slash-delimited segments."
          }
        ],
        "responses": {
          "200": {
            "description": "Asset bytes; content type follows the file extension.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-cache"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "Asset not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-availability": {
          "screeps-com": "unverified",
          "openscreeps": "supported"
        },
        "x-sources": [
          "https://github.com/openscreeps/server/blob/3954fd26f107a4b508ccaf6b5f64e4aa951d9e91/src/http.ts#L59-L69",
