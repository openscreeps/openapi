    "/room-history/{shard}/{room}/{tick}.json": {
      "get": {
        "operationId": "platformOfficialRoomHistory",
        "summary": "Read official room-history chunk",
        "description": "Official static room-history chunk served from the history host (`CONFIG.HISTORY_URL`, https://screeps.com/room-history/). The official client requests `<shard>/<room>/<tick>.json` with a tick aligned to `serverData.historyChunkSize` (100), treats any non-200 status as missing, and fills `room` itself when absent. A chunk holds an initial object state followed by tick-keyed diffs. The body has no `ok` envelope.",
        "tags": ["Platform"],
        "security": [],
        "parameters": [
          {
            "name": "shard",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ShardName"
            },
            "description": "Shard name."
          },
          {
            "name": "room",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RoomName"
            },
            "description": "Room name."
          },
          {
            "name": "tick",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "First tick in the history chunk."
          }
        ],
        "responses": {
          "200": {
            "description": "History chunk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformHistory"
                }
              }
            }
          },
          "404": {
            "description": "History chunk not found; a static hosting error body is not guaranteed to be JSON."
          }
        },
        "x-availability": {
          "screeps-com": "supported"
        },
        "x-sources": [
          "https://screeps.com/a/build.min.js?bust=1787842760865#L1C313063",
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/ScreepsHttpClient.ts#L370-L398",
          "https://github.com/screepers/node-screeps-api/blob/0f861874ff119b7ba37d0d1a4beb90f096209f4e/src/http/base.ts#L187-L209"
        ],
        "x-unverified": "Static-host error bodies are not JSON-guaranteed; whether `room` is always present is unverified (the client tolerates its absence)."
      }
    }
  },
  "components": {
    "schemas": {
      "PlatformVersion": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "integer",
            "const": 1
          },
          "protocol": {
            "type": "integer"
          },
          "package": {
            "type": "integer"
          },
          "databaseVersion": {
            "type": "integer"
          },
          "packageVersion": {
            "type": "string"
          },
          "useNativeAuth": {
            "type": "boolean"
          },
          "users": {
            "type": "integer"
          },
          "currentSeason": {
            "type": "string"
          },
          "decorationConvertationCost": {
            "type": "number"
          },
          "decorationPixelizationCost": {
            "type": "number"
          },
          "serverData": {
            "type": "object",
