{
  "name": "@openscreeps/openapi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Official Screeps contracts, standalone compatibility profile, and generated TypeScript clients",
  "license": "ISC",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./official": "./openapi.json",
    "./profiles/standalone": "./profiles/standalone.json",
    "./contracts": "./lib/contracts.mjs",
    "./generate": "./scripts/generate-clients.mjs",
    "./client-runtime": {
      "types": "./dist/clients/runtime.d.ts",
      "import": "./dist/clients/runtime.js"
    },
    "./clients/official": {
      "types": "./dist/clients/generated/official/index.d.ts",
      "import": "./dist/clients/generated/official/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "openapi.json",
    "openapi.yaml",
    "profiles/",
    "lib/",
    "spec/",
    "clients/",
    "dist/clients/",
    "scripts/build.mjs",
    "scripts/generate-clients.mjs",
    "scripts/generate-clients.d.mts",
    "tsconfig.clients.json",
    "sources.json",
    "coverage.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/check.mjs && redocly lint openapi.yaml && npm run check:generated && npm run build:clients && npm run typecheck && npm test",
    "inventory": "node scripts/inventory.mjs",
    "smoke": "node scripts/smoke.ts",
    "generate:client": "node scripts/generate-clients.mjs --input openapi.json --output clients/generated/official --name official",
    "check:generated": "node scripts/generate-clients.mjs --input openapi.json --output clients/generated/official --name official --check",
    "build:clients": "tsc -p tsconfig.clients.json",
    "typecheck": "node test/fixtures/client-fixture.ts && tsc -p tsconfig.tests.json",
    "test": "node --test test/*.test.ts",
    "prepare": "npm run build && npm run generate:client && npm run build:clients",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.62.1",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.9"
  }
}
