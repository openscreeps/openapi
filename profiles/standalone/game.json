  "excluded": {
    "gameFinish": "Ends a hosted game-mode session in a room (the client's local counterpart marks the game info `finished`, as used by survival/custom modes); a persistent single world has no finishable session and no standalone implementation serves it.",
    "gameHistoryShare": "Hosted replay sharing service: it mints `screeps.com/s/<code>` short links, which only screeps.com can resolve.",
    "gameShardsInfo": "Multi-shard directory of screeps.com (per-shard CPU limits, users, tick statistics). A standalone server runs one world; the official client calls it only on its shards pages and, behind `options.official`, for the shard CPU-limit warning before first-spawn placement.",
    "gameShardsTick": "Multi-shard routing: the official client requests `game/shards/tick` only when `options.official` is true; standalone servers provide the private-server `gameTick` addition (`GET /api/game/tick`) instead.",
    "powerCreepsPromo": "Time-limited screeps.com Global Power Level promotion (`CONFIG.OFFER_POWER_LEVEL_PROMO_END_TIME`); a standalone server runs no hosted offers."
  },
  "adaptations": {
    "gameCreateInvader": "The standalone success body carries the inserted invader creep document next to `ok`.",
    "gameMapStats": "Standalone rankings for `<stat><interval>` are complete per-player arrays of `{user, value}` sorted descending instead of the single ranking entry documented for screeps.com.",
    "gameRoomDecorations": "No hosted decoration inventory: the decoration list is always empty and is served without authentication.",
    "marketMyOrders": "Single world: the caller's orders are returned as a flat `list` instead of being grouped by shard under `shards`; the official client accepts `list` when `shards` is absent.",
    "powerCreepsCreate": "The standalone success body carries a copy of the created power creep record next to `ok`."
  },
  "additions": {
    "gameTick": "The official web client requests `GET /api/game/tick` for the room renderer's tick duration whenever `options.official` is false (screeps.com uses `game/shards/tick`), so every standalone server must serve it."
  },
  "notes": {
    "gameAddGlobalIntent": "Successive calls append to the caller's pending global intent lists, which the next tick merges into the caller's script intents. `generatePixel`, `unlockCpu` and `activateAccess` are dropped (only the player runtime may record them).",
    "gameAddObjectIntent": "Additionally requires `_id` (`invalid object`), requires the object to be in `room` (`invalid object`) and owned by the caller or, if unowned, in a room whose controller the caller owns (`not owner`), and rejects payload shapes the processor cannot handle (`invalid params`). An array `intent` is accepted only when `_id` is `room`; room-level list intents must be arrays of objects whose `roomName` equals `room`.",
    "gameChangeFlagColor": "Without `room` nothing is saved and the call still succeeds; an empty flag document is created if the caller had none in that room. The success body is exactly `{ok: 1}`.",
    "gameCreateConstruction": "The success body is `{ok: 1, _id}` without the MongoDB insert-result fields.",
    "gameCreateFlag": "The success body is exactly `{ok: 1}` (no MongoDB `result`).",
    "gameCreateInvader": "An unknown `size`/`type` or a position outside 0..49 is rejected with `invalid params`.",
    "gameMapStats": "`rooms` must be an array and `statName` a string ending in digits (`invalid params` otherwise). Rankings are computed from per-minute statistics as arrays of `{user, value}` sorted descending; only users that still exist are counted. Non-string room names and rooms without a room document are ignored; `own.user` is omitted for an invader core without a user.",
    "gamePlaceSpawn": "Placing the first spawn does not change CPU settings.",
    "gameRemoveFlag": "A missing `room` succeeds without effect; an empty flag document is created when none existed. The success body is exactly `{ok: 1}`.",
    "gameRoomDecorations": "No decoration inventory exists: the response is always `{ok: 1, decorations: []}`, also without authentication.",
    "gameRoomOverview": "Requires `room` (`invalid room`), falls back to an 8-minute interval for unsupported values (`invalid params` for malformed input), sums every player's statistics in the room and reports every stat in `totals`, including zeros.",
    "gameRooms": "A non-array `rooms` is rejected with `invalid params`; repeated names are deduplicated.",
    "gameSetNotifyWhenAttacked": "An unknown object yields `invalid object`. The success body is exactly `{ok: 1}`.",
    "gameTick": "Until two ticks have completed the configured tick duration is reported.",
    "gameWorldSize": "Width and height are one square size computed from the room documents (0 for an empty world).",
    "marketMyOrders": "Orders of the single world are returned as a flat `list` instead of per-shard `shards`; the official client accepts `list` when `shards` is absent.",
    "marketOrders": "Without `resourceType` every active order is returned.",
    "marketStats": "Without `resourceType` the history of every resource is returned.",
    "powerCreepsCreate": "The success body is `{ok: 1, ...creep}`: a copy of the new record (`level: 0`, `hitsMax: 1000`, `storeCapacity: 100`, `spawnCooldownTime: 0`, `powers: {}`).",
    "powerCreepsUpgrade": "Non-integer levels are also rejected with `invalid value for power <id>`."
  },
